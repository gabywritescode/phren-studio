---
import { SITE } from '@/site.config';
import { UI, getLang } from '@/i18n';

const t = UI[getLang(Astro.url)];
const year = new Date().getFullYear();
---

<footer class="border-line border-t">
  <div
    class="text-ink-soft mx-auto flex max-w-3xl flex-col gap-4 px-6 py-8 font-mono text-xs sm:flex-row sm:items-center sm:justify-between"
  >
    <p>© {year} {SITE.name} · Madrid</p>

    <nav class="flex flex-wrap items-center gap-4" aria-label="Contact and social">
      <a href={`mailto:${SITE.email}`} class="hover:text-signal transition-colors">{SITE.email}</a>
      {
        SITE.social.map((link) => (
          <a href={link.href} class="hover:text-signal transition-colors" rel="me">
            {link.label}
          </a>
        ))
      }
      <a href="#top" class="hover:text-signal transition-colors">{t.top}</a>
    </nav>
  </div>
</footer>
