---
import ThemeToggle from '@/components/ThemeToggle.astro';
import { SITE, NAV_LINKS } from '@/site.config';
import { url, stripBase } from '@/utils/url';

const currentPath = stripBase(Astro.url.pathname).replace(/\/$/, '') || '/';
---

<header class="border-line bg-paper/90 sticky top-0 z-40 border-b backdrop-blur">
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-5 py-4 sm:px-6">
    <a href={url('/')} class="font-display text-ink text-lg leading-tight font-medium">
      <span class="hidden sm:inline">{SITE.name}</span>
      <span class="sm:hidden">Phren</span>
    </a>

    <nav class="flex items-center gap-3 sm:gap-5" aria-label="Primary">
      {
        NAV_LINKS.map((link) => {
          const isActive = currentPath === link.href || currentPath.startsWith(`${link.href}/`);
          return (
            <a
              href={url(link.href)}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'font-mono text-[11px] tracking-wide uppercase transition-colors sm:text-xs',
                isActive ? 'text-signal' : 'text-ink-soft hover:text-ink',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
      <span class="hidden sm:block"><ThemeToggle /></span>
    </nav>
  </div>
</header>
